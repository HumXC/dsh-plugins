{
  "name": "dsh-tray",
  "version": "0.1.0",
  "description": "Linux system tray (StatusNotifierItem) for DeepSeek Harness: session status dot, tooltip, activation jump, and a right-click menu (new session / session list)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bundle.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && test/run-bus-tests.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deltachat/dbus-next": "^1.0.1",
    "open": "^11.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web-frontend": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-frontend": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web-frontend": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@types/node": "^22",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tray",
    "statusnotifier",
    "linux"
  ]
}
